{
  "buildCommand": "node scripts/parse.js && node scripts/build.js",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.columbusfoodfiles.com" }],
      "destination": "https://columbusfoodfiles.com/$1",
      "permanent": true
    }
  ]
}
